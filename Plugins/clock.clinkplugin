{
  "id": "clock",
  "name": "Clock",
  "icon": "clock",
  "summary": "The time on a key, for a custom layout",
  "version": "1.0",
  "author": "Clink",
  "enabled": true,
  "source": "# A clock for a custom layout.\n#\n# Add it from Layout > Arrange > Element and pick Clock or Clock with date.\n# Elements redraw about once a second, so the minute turns over on its own and\n# the plugin needs no hooks at all to stay current.\n\nimport time\n\ndef initial():\n    return {\"h24\": True}\n\ndef elements(state):\n    return [\n        element(\"clock\", \"Clock\", icon=\"clock\", width=2),\n        element(\"clock_date\", \"Clock with date\", icon=\"calendar\", width=3),\n    ]\n\ndef draw(id, state):\n    clock = \"HH:mm\" if state[\"h24\"] else \"h:mm a\"\n    if id == \"clock_date\":\n        return vstack([\n            text(time.format(clock), size=13, weight=\"semibold\"),\n            text(time.format(\"EEE d MMM\"), size=9, color=\"gray\"),\n        ], spacing=1)\n    return text(time.format(clock), size=15, weight=\"semibold\")\n\ndef settings(state):\n    return vstack([\n        toggle(\"24-hour clock\", state[\"h24\"], key=\"h24\"),\n        text(\"Add a clock to a custom layout from Layout > Arrange > Element.\",\n             size=13, color=\"gray\"),\n    ])\n"
}
