{
  "id": "typewriter",
  "name": "Typewriter",
  "icon": "keyboard.badge.ellipsis",
  "summary": "Typewriter key caps, a typebar press and clacky haptics",
  "version": "1.0",
  "author": "Clink",
  "enabled": true,
  "source": "# A typewriter, in three parts.\n#\n# key_styles(state) gives the theme editor two caps. Pick one under Design >\n# Style > From plugins and only the fields it names change, so the theme keeps\n# its colours:\n#   Typewriter     the moulded office machine cap: chamfered corners, a\n#                  raised face and a hard shadow underneath.\n#   Chrome Ring    the older round key, a domed face held in a metal ring.\n#\n# animations(state) adds Typebar under Look > Reactions > Geometry, a key that\n# goes a long way down and comes back stiff, and Strike under Letters, the\n# letter jumping up at the paper.\n#\n# haptics(state) makes the letters clack, and gives return the thunk of a\n# carriage coming back. Its switch sits under Sound & Haptics.\ndef initial():\n    return {\"on\": True}\n\ndef settings(state):\n    return section(\"haptics.feel\", [\n        toggle(\"Typewriter haptics\", state[\"on\"], action=\"on\"),\n    ], title=\"Typewriter\")\n\ndef on_action(action, value, state):\n    if action == \"on\":\n        state[\"on\"] = value\n    return state\n\ndef key_styles(state):\n    return [\n        key_style(\"typewriter\", \"Typewriter\", icon=\"keyboard\",\n                  material=\"3d\", variant=\"retro\", shape=\"bevel\",\n                  inner_radius=6, face_inset=4, edges=True, raised=True,\n                  light_angle=300, shadow=0.7, shadow_radius=1, shadow_y=4),\n        key_style(\"chrome-ring\", \"Chrome Ring\", icon=\"circle.circle\",\n                  material=\"metal\", shape=\"dome\", inner_radius=50,\n                  outline=2.5, outline_opacity=0.9,\n                  shadow=0.5, shadow_radius=3, shadow_y=3),\n    ]\n\ndef animations(state):\n    return [\n        press_animation(\"typebar\", \"Typebar\", icon=\"arrow.down.to.line\",\n                        scale_x=0.97, scale_y=0.9, y=5, response=0.12, damping=0.9),\n        letter_animation(\"strike\", \"Strike\", icon=\"arrow.up.to.line\",\n                         y=-6, scale=1.08, anchor=\"bottom\"),\n    ]\n\ndef haptics(state):\n    if not state[\"on\"]:\n        return {}\n    return {\n        \"letters\": feel(\"rigid\", intensity=0.8, sharpness=1),\n        \"space\": feel(\"medium\", intensity=0.6, sharpness=0.4),\n        \"return\": feel(\"heavy\", intensity=1, sharpness=0.2),\n        \"delete\": feel(\"rigid\", intensity=0.5, sharpness=0.8),\n    }\n"
}
